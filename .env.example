# LLM gateway settings. Every variable the application or compose reads is listed here.
# Format: NAME=  # required|optional (default) - purpose. Never put real values here.

APP_ENV=development  # optional (production) - development | production
APP_REVISION=local  # optional (unknown) - revision reported by /health; the release sets it
LOG_LEVEL=info  # optional (info) - debug | info | warning | error
DATABASE_URL=  # required - PostgreSQL URL for host-side tools, e.g. the local DB on DB_HOST_PORT
DB_POOL_MIN_SIZE=1  # optional (1) - API connection pool minimum
DB_POOL_MAX_SIZE=5  # optional (5) - API connection pool maximum

# Owner notifier (Telegram). Delivery stays disabled until both values are set.
NOTIFIER_TELEGRAM_BOT_TOKEN=  # optional - token of a dedicated notifier bot; secret
NOTIFIER_TELEGRAM_CHAT_ID=  # optional - numeric chat ID that receives alerts
NOTIFIER_DEDUPE_WINDOW_SECONDS=900  # optional (900) - repeats within this window are counted, not re-sent
NOTIFIER_MAX_EVENT_AGE_SECONDS=86400  # optional (86400) - undelivered alerts older than this expire

# Local Docker stack
POSTGRES_DB=llm_gateway  # optional (llm_gateway)
POSTGRES_USER=llm_gateway  # optional (llm_gateway)
POSTGRES_PASSWORD=  # required - generate a random local value
DB_HOST_PORT=5433  # optional (5433) - loopback port of the local database
API_HOST_PORT=8360  # optional (8360) - loopback port of the local API

# Tests
TEST_DATABASE_URL=  # optional - disposable database for tests marked db; scripts/check requires it
