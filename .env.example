# LLM gateway settings. Every variable the application or compose reads is listed here.
# Format: NAME=  # required|optional (default) - purpose. Never put real values here.

APP_ENV=development  # optional (production) - development | production
APP_REVISION=local  # optional (unknown) - revision reported by /health; the release sets it
LOG_LEVEL=info  # optional (info) - debug | info | warning | error
DATABASE_URL=  # required - PostgreSQL URL for host-side tools, e.g. the local DB on DB_HOST_PORT
DB_POOL_MIN_SIZE=1  # optional (1) - API connection pool minimum
DB_POOL_MAX_SIZE=5  # optional (5) - API connection pool maximum

# Project authentication
PROJECT_KEY_PEPPER=  # required - base64url, at least 32 random bytes; secret. Changing it invalidates every project key
AUTH_FAILURE_LIMIT_PER_MINUTE=10  # optional (10) - failed authentications per source per minute before throttling
TRUSTED_CLIENT_IP_HEADER=  # optional - client IP header set by a trusted proxy, e.g. CF-Connecting-IP behind the tunnel

# Model calls
LLM_CALL_TIMEOUT_SECONDS=180  # optional (180) - provider call deadline; admitted calls unfinished a minute later become execution_unknown
OLLAMA_BASE_URL=  # optional - private HTTP base URL of the GPU-only Ollama service; no credentials/query/fragment
OCR_BASE_URL=  # optional - private HTTP base URL of the GPU-only OCR service
EMBEDDINGS_BASE_URL=  # optional - private HTTP base URL of the GPU-only embedding service
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=  # required - dedicated Fernet key for project provider credentials; secret
RESULT_ENCRYPTION_KEY=  # required - Fernet key (urlsafe base64 of 32 bytes) for stored call results; secret
RESULT_RETENTION_SECONDS=86400  # optional (86400) - how long completed results can be replayed
REQUEST_MAX_BYTES=20000000  # optional (20000000) - largest accepted call body
DEFAULT_MAX_OUTPUT_TOKENS=4096  # optional (4096) - used when neither request nor profile sets it

# Allocation: shared capacity that project grants divide, and per-grant minimums
ALLOCATION_CAPACITY_REQUESTS_PER_MINUTE=120  # optional (120)
ALLOCATION_CAPACITY_CONCURRENCY=8  # optional (8) - concurrent provider calls across all projects
GLOBAL_MONTHLY_BUDGET_USD=5.00  # optional (5.00) - hard cap on all grants' monthly budgets together
ALLOCATION_MIN_REQUESTS_PER_MINUTE=5  # optional (5) - guaranteed per grant when requested
ALLOCATION_MIN_CONCURRENCY=1  # optional (1)
ALLOCATION_MIN_MONTHLY_BUDGET_USD=0.10  # optional (0.10)

# Owner notifier (Telegram). Delivery stays disabled until both values are set.
NOTIFIER_TELEGRAM_BOT_TOKEN=  # optional - token of a dedicated notifier bot; secret
NOTIFIER_TELEGRAM_CHAT_ID=  # optional - numeric chat ID that receives alerts
NOTIFIER_DEDUPE_WINDOW_SECONDS=900  # optional (900) - repeats within this window are counted, not re-sent
NOTIFIER_MAX_EVENT_AGE_SECONDS=86400  # optional (86400) - undelivered alerts older than this expire

# Local Docker stack
POSTGRES_DB=llm_gateway  # optional (llm_gateway)
POSTGRES_USER=llm_gateway  # optional (llm_gateway)
POSTGRES_PASSWORD=  # required - generate a random local value
DB_HOST_PORT=54330  # optional (54330) - loopback port of the local database
API_HOST_PORT=8360  # optional (8360) - loopback port of the local API

# Tests
TEST_DATABASE_URL=  # optional - disposable database for tests marked db; scripts/check requires it
